# Environment Configuration (Development Example)
# Copy this file to .env and update with your values

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=False

# OAuth GitHub Configuration (Optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://localhost:5000/auth/github/callback

# OAuth Google Configuration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://localhost:5000/auth/google/callback

# Database
# MySQL (XAMPP default)
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/secure_document_vault
#
# SQLite (optional fallback if you want file DB)
# DATABASE_URL=sqlite:///vault.db

# Upload Configuration
MAX_FILE_SIZE=500000000  # 500MB in bytes
UPLOAD_FOLDER=uploads

# Security
CORS_ORIGINS=https://localhost:5000,https://localhost:3000

# Certificate Paths (for development)
CERT_PATH=certificates/cert.pem
KEY_PATH=certificates/key.pem
